#!/usr/bin/env bash
# muxpoon - pin tmux windows to numbered slots and jump to them, across servers.
#
# One line per slot: server, session, window id, session_created, window name (a label,
# never matched). A file, not a tmux option, because it is ordered, spans servers and
# outlives a kill-server. Ids restart after one, so the stamp must still match or the jump
# lands on the session; a 2-field line is a plain session pin.

set -uo pipefail

usage() {
  cat <<'EOF'
usage: muxpoon <verb>
  toggle     pin or unpin this window
  jump <n>   jump to slot n
  menu       edit the list in $EDITOR: reorder lines, delete a line to unpin
  ls         print the slots
  file       print the list's path
EOF
}

# opt <name> -- an @muxpoon-* option of the server this runs under; empty outside tmux.
opt() {
  [ -n "${TMUX:-}" ] || return 0
  tmux show-option -gqv "@muxpoon-$1" 2>/dev/null
}

SLOT_FILE="${MUXPOON_FILE:-$(opt file)}"
SLOT_FILE="${SLOT_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/muxpoon/slots}"
SLOT_FILE="${SLOT_FILE/#\~/$HOME}"

# A message from a key, not a failure: run-shell turns a non-zero exit into a "returned 1"
# popup that reads as a broken binding, and any stdout into view mode over the pane.
say() {
  if [ -n "${TMUX:-}" ]; then
    tmux display-message "muxpoon: $*"
  else
    printf 'muxpoon: %s\n' "$*"
  fi
}

die() {
  printf 'muxpoon: %s\n' "$*" >&2
  exit 1
}

# Slots in order, blank and malformed lines dropped, so a stray empty line left by the
# menu never shifts the numbering.
slots() { awk -F'\t' 'NF >= 2 && $1 != "" && $2 != ""' "$SLOT_FILE" 2>/dev/null; }

# The matched part of a slot line: server, session, window id, stamp.
key() { awk -F'\t' '{ print $1 FS $2 FS $3 FS $4 }'; }

# server_of <socket_path> -- a socket in tmux's own directory goes by its -L name, any other
# by its path. realpath, because tmux resolves that directory itself (/tmp is a link on macOS).
server_of() {
  local dir
  dir="$(realpath "${TMUX_TMPDIR:-/tmp}")/tmux-$(id -u)"
  case "$1" in
    "$dir"/*) printf '%s' "${1##*/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

sock_flag() {
  case "$1" in
    */*) printf -- '-S' ;;
    *) printf -- '-L' ;;
  esac
}

# on <server> <tmux args> -- run tmux against a slot's server.
on() {
  local srv="$1"
  shift
  tmux "$(sock_flag "$srv")" "$srv" "$@"
}

# "<server>\t<session>\t<window_id>\t<session_created>\t<window_name>" of the calling
# client, in one display-message so every field describes the same moment.
here() {
  local loc sock sess rest
  [ -n "${TMUX:-}" ] || return 1
  loc="$(tmux display-message -p "#{socket_path}"$'\t'"#{session_name}"$'\t'"#{window_id}"$'\t'"#{session_created}"$'\t'"#{window_name}" 2>/dev/null)" || return 1
  IFS=$'\t' read -r sock sess rest <<<"$loc"
  [ -n "$sock" ] && [ -n "$sess" ] || return 1
  printf '%s\t%s\t%s\n' "$(server_of "$sock")" "$sess" "$rest"
}

# live_name <server> <session> <window_id> <stamp> -- the window's current name, or fail
# when the window is gone or the session was recreated since the pin (ids get reused).
live_name() {
  on "$1" list-windows -t "=$2" -F "#{session_created}"$'\t'"#{window_id}"$'\t'"#{window_name}" 2>/dev/null |
    awk -F'\t' -v s="$4" -v w="$3" '$1 == s && $2 == w { print $3; f = 1; exit } END { exit !f }'
}

cmd_toggle() {
  local cur k rest n name
  cur="$(here)" || { say "not inside tmux"; return 0; }
  k="$(key <<<"$cur")"
  name="$(cut -f2 <<<"$cur"):$(cut -f5 <<<"$cur")"
  mkdir -p "${SLOT_FILE%/*}"
  if slots | key | grep -qxF -- "$k"; then
    rest="$(slots | awk -F'\t' -v k="$k" '($1 FS $2 FS $3 FS $4) != k')"
    printf '%s' "${rest:+$rest$'\n'}" > "$SLOT_FILE"
    say "unpinned $name"
  else
    rest="$(slots)"
    printf '%s%s\n' "${rest:+$rest$'\n'}" "$cur" > "$SLOT_FILE"
    n="$(slots | wc -l | tr -d ' ')"
    say "$name -> slot $n"
  fi
}

# at_slot <cur> <row> -- is the client already where this slot points? A session pin
# matches anywhere in its session, a window pin only on its window.
at_slot() {
  local cur="$1" row="$2"
  case "$(cut -f3 <<<"$row")" in
    '') [ "$(cut -f1-2 <<<"$cur")" = "$(cut -f1-2 <<<"$row")" ] ;;
    *) [ "$(key <<<"$cur")" = "$(key <<<"$row")" ] ;;
  esac
}

# hop <server> <session> <target> -- reach a session switch-client cannot: another server,
# or one that is not running. The @muxpoon-goto command gets it first when it is on PATH.
hop() {
  local srv="$1" sess="$2" target="$3" goto attach
  goto="$(opt goto)"
  if [ -n "$goto" ] && command -v "${goto%% *}" >/dev/null 2>&1; then
    # shellcheck disable=SC2086 # the option is a command and its arguments
    exec $goto "$srv" "$target"
  fi

  on "$srv" has-session -t "=$sess" 2>/dev/null || { say "$sess is not running on ${srv##*/}"; return 0; }
  [ "$target" = "$sess" ] || on "$srv" select-window -t "=$target"

  [ -n "${TMUX:-}" ] || exec tmux "$(sock_flag "$srv")" "$srv" attach-session -t "=$sess"

  # A client cannot change servers, so this one is replaced by a client of the other. tmux
  # leaves $TMUX set for the -E command, still naming the server being left.
  attach="$(printf 'exec env -u TMUX tmux %s %q attach-session -t %q' "$(sock_flag "$srv")" "$srv" "=$sess")"
  tmux detach-client -E "$attach"
}

cmd_jump() {
  local n="${1:-}" row srv sess wid stamp target cur cur_srv=""
  case "$n" in ''|*[!0-9]*|0) say "jump needs a slot number"; return 0 ;; esac
  row="$(slots | sed -n "${n}p")"
  [ -n "$row" ] || { say "slot $n is empty"; return 0; }
  IFS=$'\t' read -r srv sess wid stamp _ <<<"$row"

  if cur="$(here)"; then
    cur_srv="${cur%%$'\t'*}"
    at_slot "$cur" "$row" && return 0
  fi

  target="$sess"
  [ -n "${wid:-}" ] && live_name "$srv" "$sess" "$wid" "${stamp:-}" >/dev/null && target="$sess:$wid"

  if [ "$srv" = "$cur_srv" ] && tmux has-session -t "=$sess" 2>/dev/null; then
    [ "$target" = "$sess" ] || tmux select-window -t "=$target"
    tmux switch-client -t "=$sess"
    return 0
  fi

  hop "$srv" "$sess" "$target"
}

cmd_menu() {
  local tmp
  mkdir -p "${SLOT_FILE%/*}"
  tmp="$(mktemp "${SLOT_FILE}.XXXXXX")" || die "cannot create a temp file"
  slots > "$tmp"
  local ed="${EDITOR:-vi}"
  case "${ed##*/}" in
    # Esc and q save and close, like the nvim harpoon menu with save_on_toggle.
    nvim|vim) "$ed" -c 'nnoremap <buffer> <Esc> <Cmd>wq<CR>' -c 'nnoremap <buffer> q <Cmd>wq<CR>' "$tmp" ;;
    *) "$ed" "$tmp" ;;
  esac
  # Normalise on the way back in: blank lines dropped, duplicates collapsed to the first.
  awk -F'\t' 'NF >= 2 && $1 != "" && $2 != "" && !seen[$0]++' "$tmp" > "$SLOT_FILE"
  rm -f "$tmp"
}

cmd_ls() {
  local cur="" i=0 row srv sess wid stamp label mark state live
  cur="$(here)" || cur=""
  while IFS= read -r row; do
    i=$((i + 1))
    IFS=$'\t' read -r srv sess wid stamp label <<<"$row"
    mark=" "; [ -n "$cur" ] && at_slot "$cur" "$row" && mark="*"
    state=""
    if ! on "$srv" has-session -t "=$sess" 2>/dev/null; then
      state="  (gone)"
    elif [ -n "${wid:-}" ]; then
      if live="$(live_name "$srv" "$sess" "$wid" "${stamp:-}")"; then label="$live"; else state="  (window gone)"; fi
    fi
    printf '%s %d  %-8s %s%s\n' "$mark" "$i" "${srv##*/}" "$sess${wid:+:${label:-$wid}}" "$state"
  done < <(slots)
  [ "$i" -gt 0 ] || echo "nothing pinned"
}

case "${1:-}" in
  toggle) cmd_toggle ;;
  jump)   shift; cmd_jump "${1:-}" ;;
  menu)   cmd_menu ;;
  ls)     cmd_ls ;;
  file)   printf '%s\n' "$SLOT_FILE" ;;
  -h|--help|help|'') usage ;;
  *)      die "unknown verb: $1 (toggle | jump <n> | menu | ls | file)" ;;
esac
